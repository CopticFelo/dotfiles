{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Caps Lock → Hyper Key (⌃⌥⇧⌘) (Caps Lock if alone)",
                        "manipulators": [
                            {
                                "from": { "key_code": "caps_lock" },
                                "to": [
                                    {
                                        "key_code": "left_control",
                                        "modifiers": ["left_command", "left_option"]
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Q (Hold) --> RMB",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.roblox\\.RobloxPlayer$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": { "key_code": "q" },
                                "parameters": {
                                    "basic.to_if_alone_timeout_milliseconds": 200,
                                    "basic.to_if_held_down_threshold_milliseconds": 200
                                },
                                "to_if_alone": [{ "key_code": "q" }],
                                "to_if_held_down": [{ "pointing_button": "button2" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Main",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        },
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Caps lock -> esc (in Neovim only)",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.googlecode\\.iterm2$",
                                            "^net\\.kovidgoyal\\.kitty$",
                                            "^com\\.neovide\\.neovide$"
                                        ],
                                        "file_paths": ["/Applications/Neovide.app/Contents/MacOS/neovide", "/opt/homebrew/bin/neovide"],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": { "key_code": "caps_lock" },
                                "to": { "key_code": "escape" },
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "No-Q mod",
